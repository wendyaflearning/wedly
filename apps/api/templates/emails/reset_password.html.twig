{% extends 'emails/base.html.twig' %}

{% block title %}Réinitialisez votre mot de passe Wedly{% endblock %}

{% block logo_src %}https://res.cloudinary.com/dadvrspox/image/upload/v1781796191/logo_light_kcub6h.svg{% endblock %}

{% block extra_styles %}
    .text { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; line-height: 1.75; color: #9D4F1E; margin: 0 0 20px 0; }
    .cta-btn { font-family: 'Cormorant Garamond', Georgia, serif; display: inline-block; background-color: #e35704; color: #FFF6ED !important; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 12px; padding: 16px 36px; letter-spacing: 0.01em; }
    .expire-note { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 12.5px; color: rgba(157,79,30,0.6); text-align: center; margin: 0 0 32px 0; line-height: 1.6; }
    .social-btn { font-family: 'Cormorant Garamond', Georgia, serif; display: inline-block; border: 1px solid rgba(78,26,50,0.18); border-radius: 20px; padding: 8px 20px; font-size: 13px; color: #9D4F1E; text-decoration: none; margin: 0 5px; }
    .signature-label { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 14px; color: rgba(157,79,30,0.65); margin: 0 0 4px 0; }
    .signature-team { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 13px; color: rgba(157,79,30,0.65); margin: 0; }
    .footer-legal { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 11px; color: rgba(157,79,30,0.5); margin: 0 0 4px 0; }
    .footer-email { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 11px; color: rgba(157,79,30,0.5); margin: 0; }
{% endblock %}

{% block body %}

              <!-- Greeting -->
              <p class="greeting">Bonjour <span class="greeting-italic">{{ firstName }},</span></p>

              <!-- Intro -->
              <p class="text">
                Vous avez demandé à réinitialiser votre mot de passe. Pas de panique, ça arrive aux meilleurs.
              </p>

              <!-- Separator -->
              <hr class="separator">

              <!-- Main message -->
              <p class="text">
                Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe. Ce lien est valable <strong style="color: #4E1A32;">1 heure</strong>.
              </p>

              <!-- CTA -->
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 8px 0 16px 0;">
                    <a href="{{ resetLink }}" class="cta-btn">Choisir un nouveau mot de passe</a>
                  </td>
                </tr>
              </table>

              <p class="expire-note">Ce lien expire dans 1 heure. Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email.</p>

              <hr class="divider">

              <!-- Social -->
              <p class="social-label">En attendant, suivez l'aventure Wedly</p>
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="https://instagram.com/wedlyapps" class="social-btn">Instagram</a>
                    <a href="https://tiktok.com/@wedlyapps" class="social-btn">TikTok</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <!-- Signature -->
              <p class="signature-label">À très vite,</p>
              <p class="signature-name">Jennifer &amp; Wendy</p>
              <p class="signature-team">L'équipe Wedly</p>
{% endblock %}

{% block footer_text %}Vous recevez cet email suite à une demande de réinitialisation de mot de passe.{% endblock %}
