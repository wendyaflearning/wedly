{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Réinitialisez votre mot de passe Wedly</title>
  <style>
    body { margin: 0; padding: 0; background-color: #FFF6ED; font-family: Arial, Helvetica, sans-serif; }
    table { border-spacing: 0; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .wrapper { background-color: #FFF6ED; width: 100%; }
    .container { max-width: 580px; margin: 0 auto; }
    .header { background-color: #4E1A32; padding: 32px 24px; text-align: center; }
    .body { background-color: #ffffff; padding: 40px 32px; }
    .icon-wrap { width: 64px; height: 64px; border-radius: 50%; background-color: #F5EDE6; border: 1px solid rgba(78,26,50,0.12); display: flex; align-items: center; justify-content: center; margin: 0 0 28px 0; }
    .greeting { font-size: 22px; font-weight: bold; color: #291A10; margin: 0 0 20px 0; }
    .greeting-italic { font-style: italic; color: #4E1A32; }
    .text { font-size: 15px; line-height: 1.7; color: #291A10; margin: 0 0 20px 0; }
    .separator { height: 3px; width: 48px; background-color: #E35704; margin: 0 0 24px 0; border: none; }
    .cta-wrap { text-align: center; margin: 32px 0; }
    .cta-btn { display: inline-block; background-color: #9D4F1E; color: #FFF6ED; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 12px; padding: 16px 32px; }
    .expire-note { font-size: 13px; color: #9E8E85; text-align: center; margin: 0 0 32px 0; }
    .divider { height: 1px; background-color: rgba(78,26,50,0.1); margin: 28px 0; border: none; }
    .social-label { font-size: 13px; font-style: italic; color: #9E8E85; text-align: center; margin: 0 0 16px 0; }
    .social-wrap { text-align: center; margin: 0 0 28px 0; }
    .social-btn { display: inline-block; border: 1px solid rgba(78,26,50,0.15); border-radius: 20px; padding: 8px 18px; font-size: 13px; color: #291A10; text-decoration: none; margin: 0 6px; }
    .signature-block { margin: 0 0 6px 0; }
    .signature-label { font-size: 14px; color: #9E8E85; margin: 0 0 4px 0; }
    .signature-name { font-size: 18px; font-weight: bold; color: #291A10; margin: 0 0 2px 0; }
    .signature-team { font-size: 13px; color: #9E8E85; margin: 0; }
    .footer { background-color: #FFF6ED; padding: 28px 32px; text-align: center; }
    .footer-logo { font-size: 20px; color: #4E1A32; font-weight: bold; margin: 0 0 12px 0; }
    .footer-legal { font-size: 11px; color: #999999; margin: 0 0 4px 0; }
    .footer-email { font-size: 11px; color: #9E8E85; margin: 0; }
  </style>
</head>
<body>
  <table class="wrapper" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td>
        <table class="container" width="580" align="center" cellpadding="0" cellspacing="0">

          <!-- Header -->
          <tr>
            <td class="header">
              <img src="https://res.cloudinary.com/dadvrspox/image/upload/v1781540174/logo_dark_qlvytq.png" alt="Wedly" width="120">
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td class="body">

              <!-- Icon -->
              <table cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding-bottom: 24px;">
                    <table cellpadding="0" cellspacing="0" style="width: 64px; height: 64px; border-radius: 50%; background-color: #F5EDE6; border: 1px solid rgba(78,26,50,0.12);">
                      <tr>
                        <td align="center" valign="middle" style="padding: 0;">
                          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="6.5" width="20" height="15" rx="3" stroke="#9D4F1E" stroke-width="1.5"/>
                            <path d="M4.5 8 14 14.5 23.5 8" stroke="#9D4F1E" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Greeting -->
              <p class="greeting">Bonjour <span class="greeting-italic">{{ firstName }},</span></p>

              <!-- Intro -->
              <p class="text">
                Vous avez demandé à réinitialiser votre mot de passe. Pas de panique, ça arrive aux meilleurs.
              </p>

              <!-- Separator -->
              <hr class="separator">

              <!-- Main message -->
              <p class="text">
                Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe. Ce lien est valable <strong>1 heure</strong>.
              </p>

              <!-- CTA -->
              <table class="cta-wrap" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 8px 0 12px 0;">
                    <a href="{{ resetLink }}" class="cta-btn">Choisir un nouveau mot de passe</a>
                  </td>
                </tr>
              </table>

              <p class="expire-note">Ce lien expire dans 1 heure. Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email.</p>

              <hr class="divider">

              <!-- Social -->
              <p class="social-label">En attendant, suivez l'aventure Wedly</p>
              <table class="social-wrap" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center">
                    <a href="https://instagram.com/wedly" class="social-btn">&#9711; Instagram</a>
                    <a href="https://tiktok.com/@wedly" class="social-btn">&#9834; TikTok</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <!-- Signature -->
              <div class="signature-block">
                <p class="signature-label">À très vite,</p>
                <p class="signature-name">Jennifer &amp; Wendy</p>
                <p class="signature-team">L'équipe Wedly</p>
              </div>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="footer">
              <p class="footer-logo">wedly</p>
              <p class="footer-legal">Vous recevez cet email suite à une demande de réinitialisation de mot de passe Wedly.</p>
              <p class="footer-email">bonjour@wedly.fr</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endapply %}
