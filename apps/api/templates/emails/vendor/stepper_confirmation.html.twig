{% extends 'emails/base.html.twig' %}

{% block title %}Votre profil est entre nos mains{% endblock %}

{% block extra_styles %}
    .cta-btn { font-family: Arial, Helvetica, sans-serif; display: inline-block; background-color: #4E1A32; color: #FFF6ED !important; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 12px; padding: 16px 36px; letter-spacing: 0.01em; }
    .expire-note { font-family: Arial, Helvetica, sans-serif; font-size: 12.5px; color: rgba(157,79,30,0.6); text-align: center; margin: 0 0 32px 0; line-height: 1.6; }
    .next-steps-label { font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; font-weight: bold; letter-spacing: 0.14em; text-transform: uppercase; color: #4E1A32; margin: 0 0 14px 0; }
    .next-steps-box { border-left: 3px solid #4E1A32; padding: 16px 20px; background-color: rgba(78,26,50,0.04); margin: 0 0 28px 0; }
    .next-steps-item { font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #9D4F1E; line-height: 1.65; margin: 0 0 8px 0; }
    .next-steps-item:last-child { margin-bottom: 0; }
{% endblock %}

{% block body %}
              <p class="greeting">Bonjour <span class="greeting-italic">{{ firstName }},</span></p>

              <p class="text">
                Votre profil a bien été reçu ! Merci pour le temps que vous y avez consacré.
              </p>

              <hr class="separator">

              <p class="text">
                Notre équipe va le relire avec soin pour s'assurer qu'il vous représente au mieux sur la plateforme. Comptez <strong style="color: #4E1A32;">24 à 48h</strong>.
              </p>

              <p class="next-steps-label">Ce qui se passe ensuite</p>
              <div class="next-steps-box">
                <p class="next-steps-item">- Votre profil est examiné par notre équipe.</p>
                <p class="next-steps-item">- Une fois validé, vous recevrez un email de confirmation et votre espace sera activé.</p>
              </div>


              <p class="expire-note">D'ici là, si vous avez la moindre question, on est là : <a href="mailto:contact@wedly-apps.com" style="color: rgba(157,79,30,0.7);">contact@wedly-apps.com</a></p>

              <hr class="divider">

              <p class="social-label">En attendant, suivez l'aventure Wedly</p>
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="https://instagram.com/wedlyapps" class="social-btn">Instagram</a>
                    <a href="https://tiktok.com/@wedlyapps" class="social-btn">TikTok</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <p class="signature-label">À très vite,</p>
              <p class="signature-name">Jennifer &amp; Wendy</p>
              <p class="signature-team">L'équipe Wedly</p>
{% endblock %}

{% block footer_text %}Vous recevez cet email suite à la soumission de votre profil Wedly.{% endblock %}
