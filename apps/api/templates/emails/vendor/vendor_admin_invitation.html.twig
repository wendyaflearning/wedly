{% extends 'emails/base.html.twig' %}

{% block title %}Complétez votre profil Wedly{% endblock %}

{% block extra_styles %}
    .cta-btn { font-family: Arial, Helvetica, sans-serif; display: inline-block; background-color: #9D4F1E; color: #FFF6ED !important; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 12px; padding: 16px 36px; letter-spacing: 0.01em; }
    .expire-note { font-family: Arial, Helvetica, sans-serif; font-size: 12.5px; color: rgba(157,79,30,0.6); text-align: center; margin: 0 0 32px 0; line-height: 1.6; }
    .steps-label { font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; font-weight: bold; letter-spacing: 0.14em; text-transform: uppercase; color: #4E1A32; margin: 0 0 14px 0; }
    .steps-box { border-left: 3px solid #4E1A32; padding: 16px 20px; background-color: rgba(78,26,50,0.04); margin: 0 0 28px 0; }
    .steps-item { font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #9D4F1E; line-height: 1.65; margin: 0 0 8px 0; }
    .steps-item:last-child { margin-bottom: 0; }
{% endblock %}

{% block body %}
              <p class="greeting">Bonjour <span class="greeting-italic">{{ firstName }},</span></p>

              {# COPY À VALIDER AVEC JENNY — bloc 1 : paragraphe de contexte (accord de genre à confirmer) #}
              <p class="text">
                Ravies de vous inviter à rejoindre l'aventure Wedly en commençant par compléter votre profil. Promis, ça ne prendra pas beaucoup de temps.
              </p>

              <hr class="separator">

              {# COPY À VALIDER AVEC JENNY — bloc 2 : paragraphe de transition #}
              <p class="text">
                On vous a préparé une bonne partie de votre profil, il ne vous reste que quelques informations à ajouter.
              </p>

              <p class="steps-label">Pour bien démarrer</p>
              <div class="steps-box">
                {# COPY À VALIDER AVEC JENNY — bloc 6 : puces de réassurance #}
                <p class="steps-item">— La majorité de vos informations ont déjà été renseignées par l'équipe Wedly.</p>
                <p class="steps-item">— Il vous reste à compléter : votre portfolio, vos tarifs, vos informations légales et votre mot de passe.</p>
                <p class="steps-item">— Une fois votre profil soumis, comptez 24 à 48h pour que notre équipe le valide avant l'activation de votre tableau de bord.</p>
              </div>

              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 0 0 16px 0;">
                    <a href="{{ invitationUrl }}" class="cta-btn">Compléter mon profil</a>
                  </td>
                </tr>
              </table>

              <p class="expire-note">Ce lien expire le {{ expiresAt|date('d/m/Y') }}.</p>

              <hr class="divider">

              <p class="social-label">En attendant, suivez l'aventure Wedly</p>
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="https://instagram.com/wedlyapps" class="social-btn">Instagram</a>
                    <a href="https://tiktok.com/@wedlyapps" class="social-btn">TikTok</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <p class="signature-label">À très vite,</p>
              <p class="signature-name">Jennifer &amp; Wendy</p>
              <p class="signature-team">L'équipe Wedly</p>
{% endblock %}

{% block footer_text %}Vous recevez cet email car l'équipe Wedly vous invite à compléter votre profil.{% endblock %}
