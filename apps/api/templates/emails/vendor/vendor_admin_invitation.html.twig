{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Complétez votre profil Wedly</title>
  <style>
    body { margin: 0; padding: 0; background: #fff6ed; font-family: Arial, Helvetica, sans-serif; color: #291a10; }
    .container { max-width: 560px; margin: 0 auto; padding: 36px 24px; }
    .card { background: #ffffff; border: 1px solid rgba(78,26,50,0.12); border-radius: 12px; padding: 32px; }
    h1 { margin: 0 0 16px; color: #4e1a32; font-family: Georgia, serif; font-size: 30px; line-height: 1.2; }
    p { margin: 0 0 18px; font-size: 15px; line-height: 1.7; color: rgba(41,26,16,0.72); }
    .button { display: inline-block; background: #e35704; color: #fff6ed !important; text-decoration: none; padding: 14px 24px; border-radius: 8px; font-weight: bold; }
    .note { margin-top: 20px; font-size: 12px; color: rgba(41,26,16,0.52); }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>Bienvenue {{ firstName }}</h1>
      <p>Votre profil {{ brandName }} a été préparé par l’équipe Wedly.</p>
      <p>Vous pouvez maintenant compléter les informations restantes et finaliser votre accès.</p>
      <p><a href="{{ invitationUrl }}" class="button">Compléter mon profil</a></p>
      <p class="note">Ce lien expire le {{ expiresAt|date('d/m/Y') }}.</p>
    </div>
  </div>
</body>
</html>
{% endapply %}
