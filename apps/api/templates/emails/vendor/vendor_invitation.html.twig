{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>C'est officiel — vous faites partie de Wedly</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,400;1,600&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; padding: 0; background-color: #ffffff; font-family: 'Cormorant Garamond', Georgia, serif; }
    table { border-spacing: 0; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .wrapper { background-color: #ffffff; width: 100%; }
    .container { max-width: 580px; margin: 0 auto; }
    .header { background-color: #4E1A32; padding: 28px 24px; text-align: center; }
    .body { background-color: #FFF6ED; padding: 40px 36px; }
    .greeting { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 26px; font-weight: 600; color: #4E1A32; margin: 0 0 18px 0; line-height: 1.3; }
    .greeting-italic { font-style: italic; font-weight: 400; }
    .text { font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.75; color: #9D4F1E; margin: 0 0 20px 0; }
    .separator { height: 3px; width: 48px; background-color: #E35704; margin: 0 0 24px 0; border: none; }
    .steps-label { font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; font-weight: bold; letter-spacing: 0.14em; text-transform: uppercase; color: #4E1A32; margin: 0 0 14px 0; }
    .steps-box { border-left: 3px solid #4E1A32; padding: 16px 20px; background-color: rgba(78,26,50,0.04); margin: 0 0 28px 0; }
    .steps-item { font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #9D4F1E; line-height: 1.65; margin: 0 0 8px 0; }
    .steps-item:last-child { margin-bottom: 0; }
    .cta-btn { font-family: Arial, Helvetica, sans-serif; display: inline-block; background-color: #4E1A32; color: #FFF6ED !important; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 12px; padding: 16px 36px; letter-spacing: 0.01em; }
    .note { font-family: Arial, Helvetica, sans-serif; font-size: 12.5px; color: rgba(157,79,30,0.6); text-align: center; margin: 0 0 32px 0; line-height: 1.6; }
    .divider { height: 1px; background-color: rgba(78,26,50,0.12); margin: 28px 0; border: none; }
    .social-label { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; font-style: italic; color: rgba(157,79,30,0.7); text-align: center; margin: 0 0 16px 0; }
    .social-btn { font-family: Arial, Helvetica, sans-serif; display: inline-block; border: 1px solid rgba(78,26,50,0.18); border-radius: 20px; padding: 8px 20px; font-size: 13px; color: #9D4F1E; text-decoration: none; margin: 0 5px; }
    .signature-label { font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: rgba(157,79,30,0.65); margin: 0 0 4px 0; }
    .signature-name { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 600; color: #4E1A32; margin: 0 0 2px 0; }
    .signature-team { font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: rgba(157,79,30,0.65); margin: 0; }
    .footer { background-color: #FFF6ED; padding: 24px 32px 32px; text-align: center; border-top: 1px solid rgba(78,26,50,0.1); }
    .footer-legal { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: rgba(157,79,30,0.5); margin: 0 0 4px 0; }
    .footer-email { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: rgba(157,79,30,0.5); margin: 0; }
    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; }
      .body { padding: 28px 20px !important; }
      .footer { padding: 20px !important; }
      .header { padding: 22px 16px !important; }
      .header img { width: 130px !important; }
      .greeting { font-size: 22px !important; }
      .text { font-size: 14px !important; }
      .cta-btn { display: block !important; text-align: center !important; padding: 15px 20px !important; }
      .social-btn { display: inline-block; margin: 4px 3px !important; }
    }
  </style>
</head>
<body>
  <table class="wrapper" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td>
        <table class="container" width="580" align="center" cellpadding="0" cellspacing="0">

          <!-- Header -->
          <tr>
            <td class="header">
              <img src="https://res.cloudinary.com/dadvrspox/image/upload/v1781540174/logo_dark_qlvytq.png" alt="Wedly" width="160" style="margin: 0 auto;">
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td class="body">

              <p class="greeting">Bienvenue, <span class="greeting-italic">{{ firstName }}.</span></p>

              <p class="text">
                Votre profil a été validé. À partir d'aujourd'hui, vous faites officiellement partie de Wedly — et on est sincèrement heureux de vous compter parmi les premiers.
              </p>

              <hr class="separator">

              <p class="text">
                Votre espace vous attend. Quelques étapes pour que votre profil soit au meilleur de lui-même dès le départ.
              </p>

              <p class="steps-label">Par où commencer</p>
              <div class="steps-box">
                <p class="steps-item">— Complétez votre portfolio avec vos plus belles réalisations.</p>
                <p class="steps-item">— Renseignez vos disponibilités pour ne recevoir que des demandes compatibles.</p>
                <p class="steps-item">— Finalisez votre bio — un format guidé en 3 questions.</p>
              </div>

              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 0 0 16px 0;">
                    <a href="{{ dashboardUrl }}" class="cta-btn">Accéder à mon espace</a>
                  </td>
                </tr>
              </table>

              <p class="note">Connectez-vous avec les identifiants choisis lors de votre inscription.</p>

              <hr class="divider">

              <p class="social-label">En attendant, suivez l'aventure Wedly</p>
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="https://instagram.com/wedly" class="social-btn">Instagram</a>
                    <a href="https://tiktok.com/@wedly" class="social-btn">TikTok</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <p class="signature-label">À très vite,</p>
              <p class="signature-name">Jennifer &amp; Wendy</p>
              <p class="signature-team">L'équipe Wedly</p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="footer">
              <p class="footer-legal">Vous recevez cet email car votre profil Wedly vient d'être validé.</p>
              <p class="footer-email">bonjour@wedly.fr</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endapply %}
