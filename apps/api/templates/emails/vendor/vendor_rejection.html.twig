{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Votre profil Wedly nécessite quelques ajustements</title>
  <style>
    body { margin: 0; padding: 0; background-color: #ffffff; font-family: Arial, Helvetica, sans-serif; }
    table { border-spacing: 0; }
    td { padding: 0; }
    img { border: 0; display: block; }
    .wrapper { background-color: #ffffff; width: 100%; }
    .container { max-width: 580px; margin: 0 auto; }
    .header { background-color: #4E1A32; padding: 28px 24px; text-align: center; }
    .body { background-color: #FFF6ED; padding: 40px 36px; }
    .title { font-family: Georgia, serif; font-size: 26px; font-weight: 600; color: #4E1A32; margin: 0 0 18px 0; line-height: 1.3; }
    .text { font-size: 15px; line-height: 1.75; color: #9D4F1E; margin: 0 0 20px 0; }
    .separator { height: 3px; width: 48px; background-color: #E35704; margin: 0 0 24px 0; border: none; }
    .box { border-left: 3px solid #4E1A32; padding: 16px 20px; background-color: rgba(78,26,50,0.04); margin: 0 0 28px 0; }
    .reason { font-size: 14px; color: #9D4F1E; line-height: 1.65; margin: 0 0 8px 0; }
    .note { font-size: 14px; color: #9D4F1E; line-height: 1.65; margin: 0; }
    .signature-name { font-family: Georgia, serif; font-size: 22px; font-weight: 600; color: #4E1A32; margin: 0 0 2px 0; }
    .signature-team { font-size: 13px; color: rgba(157,79,30,0.65); margin: 0; }
    .footer { background-color: #FFF6ED; padding: 24px 32px 32px; text-align: center; border-top: 1px solid rgba(78,26,50,0.1); }
    .footer-legal { font-size: 11px; color: rgba(157,79,30,0.5); margin: 0 0 4px 0; }
    .footer-email { font-size: 11px; color: rgba(157,79,30,0.5); margin: 0; }
    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; }
      .body { padding: 28px 20px !important; }
      .footer { padding: 20px !important; }
      .header { padding: 22px 16px !important; }
      .header img { width: 130px !important; }
      .title { font-size: 22px !important; }
      .text { font-size: 14px !important; }
    }
  </style>
</head>
<body>
  <table class="wrapper" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td>
        <table class="container" width="580" align="center" cellpadding="0" cellspacing="0">
          <tr>
            <td class="header">
              <img src="https://res.cloudinary.com/dadvrspox/image/upload/v1781540174/logo_dark_qlvytq.png" alt="Wedly" width="160" style="margin: 0 auto;">
            </td>
          </tr>

          <tr>
            <td class="body">
              <p class="title">Bonjour {{ firstName }},</p>

              <p class="text">
                Merci d'avoir complété votre profil Wedly. Après vérification, certains éléments doivent être ajustés avant que nous puissions le valider.
              </p>

              <hr class="separator">

              <p class="text">Points à reprendre :</p>
              <div class="box">
                {% for reason in reasons %}
                  <p class="reason">— {{ reason }}</p>
                {% endfor %}
                {% if note %}
                  <p class="note">{{ note }}</p>
                {% endif %}
              </div>

              <p class="text">
                Ces éléments nous permettent de garantir une expérience cohérente pour les couples comme pour les prestataires référencés sur Wedly.
              </p>

              <p class="text">À bientôt,</p>
              <p class="signature-name">Jennifer &amp; Wendy</p>
              <p class="signature-team">L'équipe Wedly</p>
            </td>
          </tr>

          <tr>
            <td class="footer">
              <p class="footer-legal">Vous recevez cet email suite à la vérification de votre profil Wedly.</p>
              <p class="footer-email">contact@wedly-apps.com</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endapply %}
