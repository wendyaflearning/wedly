{% extends 'emails/base.html.twig' %}

{% block title %}WedDream est prêt : on le teste au Salon du Mariage{% endblock %}

{% block extra_styles %}
    .cta-btn { font-family: Arial, Helvetica, sans-serif; display: inline-block; background-color: #9D4F1E; color: #FFF6ED !important; font-size: 15px; font-weight: bold; text-decoration: none; border-radius: 12px; padding: 16px 36px; letter-spacing: 0.01em; }
    .consent-btn { font-family: Arial, Helvetica, sans-serif; display: inline-block; border: 1px solid rgba(78,26,50,0.35); border-radius: 20px; padding: 12px 26px; font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase; color: #4E1A32; text-decoration: none; }
    .hero { background-color: #4E1A32; padding: 32px 28px; border-radius: 12px; }
    .hero-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 28px; line-height: 1.2; font-weight: 600; color: #FFF6ED; margin: 0; }
    .hero-title-accent { font-style: italic; font-weight: 400; color: #E35704; }
    .hero-text { font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.7; color: rgba(255,246,237,0.82); margin: 14px 0 0 0; }
    .eyebrow { font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; font-weight: bold; letter-spacing: 0.14em; text-transform: uppercase; color: #4E1A32; margin: 0 0 8px 0; }
    .section-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 23px; line-height: 1.25; font-weight: 600; color: #4E1A32; margin: 0 0 16px 0; }
    .quote { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 19px; line-height: 1.45; font-style: italic; color: #4E1A32; border-left: 3px solid rgba(78,26,50,0.18); padding: 2px 0 2px 18px; margin: 0; }
    .flow-step { font-family: Arial, Helvetica, sans-serif; font-size: 11px; font-weight: bold; letter-spacing: 0.06em; text-transform: uppercase; color: #4E1A32; background-color: rgba(78,26,50,0.04); border: 1px solid rgba(78,26,50,0.18); border-radius: 22px; padding: 14px 6px; line-height: 1.3; }
    .flow-arrow { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; color: rgba(157,79,30,0.65); }
    .flow-recap { font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 1.6; color: rgba(157,79,30,0.65); margin: 14px 0 0 0; }
    .panel { background-color: rgba(78,26,50,0.04); padding: 24px 22px; }
    .panel-accent { border-left: 3px solid #4E1A32; }
    .panel-item { font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.65; color: #9D4F1E; margin: 0 0 12px 0; }
    .panel-item:last-child { margin-bottom: 0; }
    .badge { font-family: Arial, Helvetica, sans-serif; display: inline-block; background-color: #4E1A32; color: #FFF6ED !important; border-radius: 20px; padding: 9px 20px; font-size: 10.5px; font-weight: bold; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; }
    .note { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 16px; font-style: italic; color: rgba(157,79,30,0.75); text-align: center; margin: 0 0 22px 0; line-height: 1.5; }
    .consent-card { background-color: rgba(78,26,50,0.04); border: 1px solid rgba(227,87,4,0.28); border-radius: 12px; padding: 30px 26px; }
    .consent-eyebrow { font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; font-weight: bold; letter-spacing: 0.14em; text-transform: uppercase; color: #E35704; margin: 0 0 8px 0; }
    @media only screen and (max-width: 600px) {
      .flow-cell { display: block !important; width: 100% !important; padding: 0 0 10px 0 !important; }
      .flow-arrow-h { display: none !important; }
      .flow-arrow-v { display: block !important; width: 100% !important; padding: 0 0 10px 0 !important; }
      .hero { padding: 26px 20px !important; }
      .hero-title { font-size: 24px !important; }
      .consent-card, .panel { padding: 20px 18px !important; }
    }
{% endblock %}

{% block body %}
              <p class="greeting">Bonjour <span class="greeting-italic">{{ firstName }},</span></p>

              {# COPY À VALIDER AVEC JENNY — bloc 1 : accroche d'annonce (hero) #}
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 30px;">
                <tr>
                  <td class="hero" align="center" bgcolor="#4E1A32">
                    <p class="hero-title">WedDream est prêt&nbsp;: on le teste au <span class="hero-title-accent">Salon du Mariage</span>&nbsp;!</p>
                    <p class="hero-text">Une nouvelle façon pour les futurs mariés de vous découvrir, directement à travers vos plus belles réalisations.</p>
                  </td>
                </tr>
              </table>

              {# COPY À VALIDER AVEC JENNY — bloc 2 : définition de WedDream #}
              <p class="eyebrow">Le concept</p>
              <p class="section-title">WedDream, qu'est-ce que c'est&nbsp;?</p>
              <p class="quote">
                Une galerie inspirationnelle qui permet aux futurs mariés de découvrir les prestataires directement à travers leur portfolio.
              </p>

              {# COPY À VALIDER AVEC JENNY — bloc 3 : les 3 étapes du parcours #}
              <table width="100%" cellpadding="0" cellspacing="0" style="margin: 26px 0 32px 0;">
                <tr>
                  <td class="flow-cell flow-step" width="30%" align="center">Portfolio</td>
                  <td class="flow-arrow flow-arrow-h flow-cell" width="5%" align="center">&rarr;</td>
                  <td class="flow-cell flow-step" width="30%" align="center">Épingler</td>
                  <td class="flow-arrow flow-arrow-h flow-cell" width="5%" align="center">&rarr;</td>
                  <td class="flow-cell flow-step" width="30%" align="center">Mise en relation</td>
                </tr>
              </table>

              <hr class="separator">

              {# COPY À VALIDER AVEC JENNY — bloc 4 : le lancement au Salon du Mariage #}
              <p class="eyebrow">Salon du Mariage</p>
              <p class="section-title">Premier lancement&nbsp;: le Salon du Mariage</p>
              <p class="text">
                WedDream fait ses tout premiers pas en phase pilote, à l'occasion du prochain Salon du Mariage. Sur place, nous irons à la rencontre des futurs mariés en micro-trottoirs pour leur faire découvrir la galerie et mettre les réalisations de {{ brandName }} sous les projecteurs. À chaque coup de cœur, ils pourront épingler une photo ou demander directement une mise en relation avec vous.
              </p>

              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 30px;">
                <tr>
                  <td align="center">
                    <span class="badge">Phase pilote 100% gratuite</span>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              {# COPY À VALIDER AVEC JENNY — bloc 5 : comment participer, les deux situations #}
              <p class="eyebrow">À vous de jouer</p>
              <p class="section-title">Comment participer&nbsp;?</p>

              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                <tr>
                  <td class="panel panel-accent">
                    <p class="panel-item">— Déjà inscrit·e sur Wedly&nbsp;? Connectez-vous à votre espace prestataire et taguez vos photos.</p>
                    <p class="panel-item">— Pas encore inscrit·e&nbsp;? C'est le moment de préparer votre portfolio pour le lancement de WedDream.</p>
                  </td>
                </tr>
              </table>

              {# COPY À VALIDER AVEC JENNY — bloc 6 : réassurance avant le CTA #}
              <p class="note">Dès votre prochaine connexion, une fenêtre s'ouvrira pour vous guider pas à pas.</p>

              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 32px;">
                <tr>
                  <td align="center">
                    <a href="{{ ctaUrl }}" class="cta-btn">{{ ctaLabel }}</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              {# COPY À VALIDER AVEC JENNY — bloc 7 : ce qui se passe en cas de demande de contact #}
              <p class="eyebrow">Mise en relation</p>
              <p class="section-title">Et si un couple demande à vous contacter&nbsp;?</p>
              <p class="text">
                Vous êtes notifié·e immédiatement et recevez ses coordonnées. La messagerie Wedly n'étant pas encore disponible, vous prenez ensuite contact directement.
              </p>
              <p class="flow-recap">Couple &rarr; Demande &rarr; Notification &rarr; Vos coordonnées &rarr; Prise de contact</p>

              {# COPY À VALIDER AVEC JENNY — bloc 8 : consentement photo pour les dépliants du salon #}
              <table width="100%" cellpadding="0" cellspacing="0" style="margin: 32px 0;">
                <tr>
                  <td class="consent-card" align="center">
                    <p class="consent-eyebrow">Dépliants du salon</p>
                    <p class="section-title">Vos photos sur nos supports</p>
                    <p class="text" style="margin-bottom: 22px;">
                      Nous préparons des dépliants WedDream pour le salon et aimerions mettre en avant certaines réalisations de {{ brandName }}. Donnez-nous simplement votre accord ci-dessous.
                    </p>
                    <a href="{{ consentFormUrl }}" class="consent-btn">Je donne mon accord</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <p class="social-label">En attendant, suivez l'aventure Wedly</p>
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="https://instagram.com/wedlyapps" class="social-btn">Instagram</a>
                    <a href="https://tiktok.com/@wedlyapps" class="social-btn">TikTok</a>
                  </td>
                </tr>
              </table>

              <hr class="divider">

              <p class="signature-label">À très vite,</p>
              <p class="signature-name">Jennifer &amp; Wendy</p>
              <p class="signature-team">L'équipe Wedly</p>
{% endblock %}

{% block footer_text %}Vous recevez cet email car vous êtes prestataire partenaire Wedly.{% endblock %}
